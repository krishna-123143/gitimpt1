<!DOCTYPE html>
<html>
<head>
<title>BookMyShow - Movies</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Arial;background:#f5f5f5;color:#222}
header{background:#333545;padding:15px 6%;display:flex;align-items:center;gap:30px}
.logo{color:#fff;font-size:28px;font-weight:bold}
.logo span{color:#f84464}
input{width:400px;padding:12px;border-radius:5px;border:0}
nav{margin-left:auto;color:white}
nav a{color:white;text-decoration:none;margin:12px}
.banner{background:#222;padding:30px 6%;color:white}
.banner h1{font-size:32px;margin-bottom:10px}
.container{padding:25px 6%}
h2{margin-bottom:20px}
.movies{display:flex;gap:20px;overflow-x:auto}
.card{background:white;width:200px;flex-shrink:0;border-radius:8px;overflow:hidden;
box-shadow:0 2px 8px #ccc}
.card img{width:100%;height:270px;object-fit:cover}
.info{padding:12px}
.info h3{margin-bottom:8px}
.rating{color:#e63950;font-weight:bold;margin-bottom:10px}
button{background:#f84464;color:white;border:0;padding:10px 20px;
border-radius:5px;cursor:pointer;width:100%}
button:hover{background:#d93655}
footer{text-align:center;background:#333545;color:white;padding:25px;margin-top:30px}
</style>
</head>
<body>
<header>
<div class="logo"><span>book</span>myshow</div>
<input type="text" placeholder="Search for Movies, Events and More">
<nav><a href="#">Movies</a><a href="#">Events</a><a href="#">Sports</a></nav>
</header>
<div class="banner"><h1>Movies in Bhubaneswar</h1>
<p>Book your favourite movie tickets online</p></div>
<div class="container">
<h2>Recommended Movies</h2>
<div class="movies">
<div class="card"><img src="movie1.jpg"><div class="info">
<h3>Coolie</h3><div class="rating">★ 8.5/10</div><button>Book Tickets</button></div></div>
<div class="card"><img src="movie2.jpg"><div class="info">
<h3>War 2</h3><div class="rating">★ 8.2/10</div><button>Book Tickets</button></div></div>
<div class="card"><img src="movie3.jpg"><div class="info">
<h3>Avengers</h3><div class="rating">★ 9.0/10</div><button>Book Tickets</button></div></div>
<div class="card"><img src="movie4.jpg"><div class="info">
<h3>Pushpa 2</h3><div class="rating">★ 8.8/10</div><button>Book Tickets</button></div></div>
</div></div>
<footer>© 2026 BookMyShow Movie Clone | For Educational Purpose</footer>
</body>
</html>
